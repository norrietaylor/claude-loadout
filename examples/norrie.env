# Personal settings for the `claude` loadout, sourced from ~/.zshrc.local
# before host.zsh. Path vars are relative to $HOME (they are patched in as
# ~/$VAR); CLAUDE_LOADOUT_MEMORY_REPO is an absolute host path.

# Memories live in claude-config under memory/projects/<slug>/, through a
# dedicated sparse clone on main (git clone --filter=blob:none --sparse
# claude-config ~/.local/share/claude-memory && git sparse-checkout set memory minimal),
# so branch work in ~/code/claude-config never moves the memory files.
# Memory commits there are SSH-signed (claude-mem setup, once).
export CLAUDE_LOADOUT_MEMORY_REPO=$HOME/.local/share/claude-memory
export CLAUDE_LOADOUT_MEMORY_SUBDIR=memory

# Sandbox settings (claude-config minimal/settings.json, via the clone on
# main), skills and output styles from claude-config,
# not from ~/.claude (whose settings.json carries host-only hooks and paths).
export CLAUDE_LOADOUT_SETTINGS=.local/share/claude-memory/minimal/settings.json
export CLAUDE_LOADOUT_SKILLS=code/claude-config/skills
export CLAUDE_LOADOUT_OUTPUT_STYLES=code/claude-config/output-styles
export CLAUDE_LOADOUT_CLAUDE_MD=.claude/CLAUDE.md

# My projects only: skip the workspace trust prompt in sessions.
export CLAUDE_LOADOUT_TRUST_WORKBENCH=1

# History import caps.
export CLAUDE_LOADOUT_HISTORY_MAX=20
export CLAUDE_LOADOUT_HISTORY_MB=80
