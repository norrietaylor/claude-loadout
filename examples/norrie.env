# Personal settings for the `claude` loadout, sourced from ~/.zshrc.local so
# that `min` (for the session path vars) and host Claude Code (for its
# SessionStart/SessionEnd hooks) both see them. Path vars are relative to
# $HOME (they are patched in as ~/$VAR).

# State remote: a private repo holding every project's memories and recent
# transcripts, cloned on the host. Commits there are SSH-signed (claude-mem
# setup, once; install.sh runs it if needed).
export CLAUDE_STATE_REPO=norrietaylor/claude-state
export CLAUDE_STATE_DIR=$HOME/.local/share/claude-state

# Sandbox settings (claude-config minimal/settings.json, via the sparse clone
# of claude-config on main at ~/.local/share/claude-memory), skills and
# output styles from claude-config, not from ~/.claude (whose settings.json
# carries host-only hooks and paths).
export CLAUDE_LOADOUT_SETTINGS=.local/share/claude-memory/minimal/settings.json
export CLAUDE_LOADOUT_SKILLS=code/claude-config/skills
export CLAUDE_LOADOUT_OUTPUT_STYLES=code/claude-config/output-styles
export CLAUDE_LOADOUT_CLAUDE_MD=.claude/CLAUDE.md

# My projects only: skip the workspace trust prompt in sessions.
export CLAUDE_LOADOUT_TRUST_WORKBENCH=1

# Transcripts kept per repo in the state remote.
export CLAUDE_LOADOUT_HISTORY_MAX=20
export CLAUDE_LOADOUT_HISTORY_MB=80
